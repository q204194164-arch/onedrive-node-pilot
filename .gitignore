# Only explicitly approved source files are publishable.
/*
!/.gitignore
!/README.md
!/LICENSE
!/PRIVACY.md
!/CONTRIBUTING.md
!/SECURITY.md
!/build.sh
!/Sources/
/Sources/*
!/Sources/App.swift
!/Sources/Engine.swift
!/Sources/LaunchWatcher.swift
!/Tests/
/Tests/*
!/Tests/EngineTests.swift
!/Tests/ProbeCLI.swift
!/Tests/IsolationCLI.swift
!/scripts/
/scripts/*
!/scripts/test.sh
!/scripts/check-public-files.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
